# Comma-separated faculty allowlists. Leave PREPZO_ADMIN_EMAILS empty until
# the Prepzo owners provide the exact administrator email addresses.
ARKE_ADMIN_EMAILS=admin@arkescholar.com,rohit@arkescholar.com
PREPZO_ADMIN_EMAILS=

# Optional canonical public-exam origins. These prevent public links from
# depending on a proxy Host header when an external delivery host is used.
NEXT_PUBLIC_ARKE_EXAM_ORIGIN=https://bank.arkescholar.com
NEXT_PUBLIC_PREPZO_EXAM_ORIGIN=https://bank.theprepzo.com
